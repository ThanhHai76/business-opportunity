# Settings of the production server. On the server:   cp .env.production.example .env   then fill it in.
# The file named .env is secret: it is in .gitignore, never commit it, never paste it in a chat.
# See DEPLOY.md.

# ---- Required ----------------------------------------------------------------------------------------------------
# The domain of the site, without https:// and without www. Must be spelled exactly like the one you bought.
DOMAIN=hanoicenturyvista.com
# An email address for Let's Encrypt (it warns there before a certificate expires).
ACME_EMAIL=
# The database password. Make it long and random, hex only (letters and digits keep it safe inside the database URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- AI (optional) ----------------------------------------------------------------------------------------------
# Without a key every AI answer is the automatic one (rule based). Get a key in the Claude Console; the key is billed
# separately and spending can be capped on the Console's Billing page.
ANTHROPIC_API_KEY=
# The model of the in-depth AI answers. Cheaper than claude-opus-5-5 / claude-opus-5; check the answers before changing.
LLM_MODEL=claude-sonnet-5-5
# AI questions per account and per day (Vietnam time). Leave empty for the defaults: 3 free, 50 with Premium, 5 Time Machine.
AI_FREE_PER_DAY=
AI_PREMIUM_PER_DAY=
AI_STORY_FREE_PER_DAY=

# ---- Email (optional but needed for verified accounts and for "forgot password") -----------------------------------
# From the SMTP service you use (Brevo, SendGrid, Resend, your own...):  smtps://user:password@smtp.example.com:465
# If the password has special characters, percent-encode them in the URL. Also set SPF and DKIM for your domain at
# that service, or the mails land in spam.
SMTP_URL=
MAIL_FROM="Hanoi Century Vista <no-reply@hanoicenturyvista.com>"
# Buying needs a verified email: on by default when SMTP_URL is set. true / false to force it.
REQUIRE_VERIFIED_EMAIL=

# ---- Payments ---------------------------------------------------------------------------------------------------
# off: nothing is for sale (the "full report" and Premium buttons say so). payos: real payments through PayOS (VietQR).
# The mock provider is refused in production on purpose.
BILLING_PROVIDER=off
BILLING_WEBHOOK_SECRET=
# PayOS: the three keys of your payment channel (my.payos.vn > Kênh thanh toán). Never commit or share them.
# After the site is up: npm run payos:webhook -- https://YOUR-DOMAIN/api/billing/webhook/payos  (in backend-node)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# 9: the memo limit for a bank account not linked through PayOS; 25 for a linked one.
PAYOS_DESCRIPTION_MAX=9
