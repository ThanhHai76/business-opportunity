# Caddy in front of the site: gets and renews the HTTPS certificate by itself (Let's Encrypt) and sends
#   /api/*   to the Node backend
#   the rest to nginx (the Angular build)
# DOMAIN and ACME_EMAIL come from the environment (docker-compose.prod.yml). Both DNS records (the domain and www)
# must point to this server BEFORE the first start, or the certificate cannot be issued.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# HTTPS only, from now on, for a year.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		# The API takes small JSON bodies only.
		request_body {
			max_size 256KB
		}
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
