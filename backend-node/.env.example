# Copy to .env (loaded automatically by server.js; real environment variables win).

# ---- Server ----
PORT=8000
# Extra allowed browser origins (comma separated), e.g. https://hanoi100.vn. Any http://localhost:* origin is
# allowed too, except when NODE_ENV=production.
CORS_ORIGIN=

# ---- Accounts and saved reports ----
# auto (default): on when DATABASE_URL is set (PostgreSQL 13+, UTF8; tables created on start), off otherwise.
# postgres: required (the server stops if the database is unreachable). memory: development only, lost on restart. off.
ACCOUNTS=auto
# Secure cookies (HTTPS only). Default: true when NODE_ENV=production.
COOKIE_SECURE=
# Behind nginx / a load balancer: number of proxies to trust for the client IP (rate limits). Empty = none.
TRUST_PROXY=

# ---- Hanoi Living Score: data source ----
# memory:   no database needed, serves the bundled SAMPLE DATA (default; great for a quick demo/tests)
# postgres: PostgreSQL + PostGIS (schema: database/living-score/01-schema.sql, see ../docker-compose.yml)
DATA_SOURCE=memory
# Also the accounts database (ACCOUNTS=auto).
DATABASE_URL=postgres://living:living@localhost:5432/living_score
# Insert the SAMPLE DATA on start-up when the areas table is empty (postgres only)
AUTO_SEED=true

# ---- Hanoi Living Score: cache (optional) ----
# Leave empty to use the in-process cache instead of Redis.
REDIS_URL=
CACHE_TTL_SECONDS=300

# ---- Hanoi Living Score: AI recommendation (optional) ----
# Without a key the API falls back to rule-based explanations (mode: "rules").
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_MS=45000

# ---- Hanoi Business Copilot + Time Machine AI Storyteller: AI provider ----
# auto: Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock. mock: always the mock.
# (OpenAI / Gemini can be added as providers in src/business-copilot/ai-provider.js.)
AI_PROVIDER=auto
