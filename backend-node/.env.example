# Copy to .env (loaded automatically by server.js; real environment variables win).

# ---- Server ----
PORT=8000
# Extra allowed browser origins (comma separated), e.g. https://hanoicenturyvista.com. Any http://localhost:* origin is
# allowed too, except when NODE_ENV=production.
CORS_ORIGIN=

# Who may read the reports of wrong figures at /admin/reports: emails of verified accounts, comma separated.
# Empty (default): nobody can.
ADMIN_EMAILS=

# ---- Accounts and saved reports ----
# auto (default): on when DATABASE_URL is set (PostgreSQL 13+, UTF8; tables created on start), off otherwise.
# postgres: required (the server stops if the database is unreachable). memory: development only, lost on restart. off.
ACCOUNTS=auto
# Secure cookies (HTTPS only). Default: true when NODE_ENV=production.
COOKIE_SECURE=
# Behind nginx / a load balancer: number of proxies to trust for the client IP (rate limits). Empty = none.
TRUST_PROXY=

# ---- In-depth AI questions (src/billing/ai-meter.js) — needs accounts ----
# auto: count AI answers per account when accounts are on and ANTHROPIC_API_KEY is set (default).
# on: count whenever accounts are on. off: AI answers are free for everyone (as before).
# Visitors not signed in get the basic (template) answer.
AI_METERING=auto
# In-depth AI answers per day (Vietnam time) for every signed-in account, and with Premium. Default 3 / 50.
AI_FREE_PER_DAY=
AI_PREMIUM_PER_DAY=
# Free in-depth AI answers per day for the Time Machine storyteller, a free allowance of its own. Default 5.
# Premium and bought AI credits are shared by every tool, the Time Machine included.
AI_STORY_FREE_PER_DAY=

# ---- Purchases (report credits, AI question packs, Premium) and paid reports — needs accounts ----
# Products and prices: src/billing/products.js
# mock: pretend checkout page to try the flow without money (default outside production; refused in production).
# off: nothing for sale (default in production). payos: real payments through PayOS (src/billing/payos-provider.js).
BILLING_PROVIDER=
# Signing key of the mock provider's webhooks (random per start when empty).
BILLING_WEBHOOK_SECRET=
# PayOS (BILLING_PROVIDER=payos): the three keys of the payment channel on my.payos.vn. Never commit them.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Added to order codes sent to PayOS, so a test database never reuses the real one's codes (PayOS refuses a code twice).
# On a machine used only for trying things, set e.g. 900000000; leave 0 on the real server.
# PAYOS_ORDER_OFFSET=0
# Memo limit: 9 for a bank account not linked through PayOS, 25 for a linked one.
# PAYOS_DESCRIPTION_MAX=9

# ---- Hanoi Living Score: data source ----
# memory:   no database needed, serves the bundled SAMPLE DATA (default; great for a quick demo/tests)
# postgres: PostgreSQL + PostGIS (schema: database/living-score/01-schema.sql, see ../docker-compose.yml)
DATA_SOURCE=memory
# Also the accounts database (ACCOUNTS=auto).
DATABASE_URL=postgres://living:living@localhost:5432/living_score
# Insert the SAMPLE DATA on start-up when the areas table is empty (postgres only)
AUTO_SEED=true

# ---- Hanoi Living Score: cache (optional) ----
# Leave empty to use the in-process cache instead of Redis.
REDIS_URL=
CACHE_TTL_SECONDS=300

# ---- Hanoi Living Score: AI recommendation (optional) ----
# Without a key the API falls back to rule-based explanations (mode: "rules").
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_MS=45000

# ---- Hanoi Business Copilot + Time Machine AI Storyteller: AI provider ----
# auto: Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock. mock: always the mock.
# (OpenAI / Gemini can be added as providers in src/business-copilot/ai-provider.js.)
AI_PROVIDER=auto

# ---- Email: verify address, reset forgotten password ----
# smtp when SMTP_URL is set; otherwise console (prints the mail in the log) outside production, off in production.
# MAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Hanoi Century Vista <no-reply@example.com>"
# Public address of the site, used in the links of the emails (required in production, or the email features stay off).
# APP_URL=https://hanoicenturyvista.com
# Buying needs a verified email: default on when the mail is real (smtp). true / false to force.
# REQUIRE_VERIFIED_EMAIL=
