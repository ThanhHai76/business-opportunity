  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.12"
  }
