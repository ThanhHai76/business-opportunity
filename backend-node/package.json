{
  "name": "opportunity-map-backend",
  "version": "1.0.0",
  "description": "Node.js/Express API for the Opportunity Map project: Business Opportunity Map + Hanoi Living Score",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "seed:living": "node src/living-score/seed/run-seed.js",
    "sync:time-machine": "node scripts/sync-time-machine.js",
    "data:living": "node scripts/build-living-osm.js",
    "data:commute": "node scripts/build-living-commute.js",
    "data:region": "node scripts/build-future-region.js",
    "data:provinces": "node scripts/build-future-provinces.js",
    "data:opportunity": "node scripts/build-opportunity-osm.js",
